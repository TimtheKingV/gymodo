SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon key aus "supabase start">
SUPABASE_SERVICE_ROLE_KEY=<service_role key aus "supabase start">

# Der Videoupload laeuft aus dem Browser direkt gegen den Storage-Dienst
# (Fortschritt und Wiederaufnahme). Dafuer braucht der Browser dieselben
# Werte -- oeffentlich, wie der Name sagt. Der Service-Role-Schluessel
# gehoert niemals hierher.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key aus "supabase start">
