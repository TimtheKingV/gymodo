{
  "name": "fitretro",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "test": "turbo run test",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "build": "turbo run build",
    "smoke:aasa": "node scripts/smoke-aasa.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "smoke:migrations": "node scripts/smoke-migrations.mjs",
    "tags": "tsx scripts/tags.ts"
  },
  "dependencies": {
    "@fitretro/domain": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.112.4",
    "@types/node": "^22.0.0",
    "dotenv": "^17.4.2",
    "supabase": "^2.116.0",
    "tsx": "^4.23.13",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
