# Vorlage fuer .env.production -- die Cloud-Werte des Projekts "Gymodo"
# (hverawzrwjgztolxuose). Kopieren nach .env.production, das gitignored ist.
#
# WOFUER: Diese Datei wird AUSSCHLIESSLICH in die Shell gesourced, um
# supabase/config.toml fuer einen Push gegen die Cloud zu interpolieren:
#
#     set -a; . ./.env.production; set +a
#     pnpm exec supabase config push
#
# NICHT ueber SUPABASE_ENV=production -- das wertet die Supabase-CLI 2.116.0
# nicht aus (geprueft am 1. September: GOTRUE_SITE_URL blieb auf dem Wert aus
# .env). In Supabases eigenem Beispiel leistet das dotenvx, nicht die CLI.
# Was verlaesslich gilt: eine echte Shell-Variable hat Vorrang vor .env --
# ebenfalls geprueft, nicht angenommen.
#
# Die Testsuite laedt diese Datei nicht -- vitest und playwright laden .env,
# und dort gehoeren Cloud-Werte niemals hinein (siehe Warnhinweis in .env,
# Nachtrag M0 vom 30. August).
#
# WARUM ES SIE GIBT: "supabase config push" ueberträgt die gesamte
# [auth]-Sektion. Ohne diese Trennung wuerde ein Push die Site-URL der
# Produktion auf 127.0.0.1 setzen.
#
# KEINE SCHLUESSEL HIER. Nur URLs. Service-Role- und Anon-Keys leben in
# Vercel (Settings -> Environment Variables) und im Supabase-Dashboard.

# Muss der Domain entsprechen, unter der Web-Fallback und Universal Links
# laufen -- heute noch die Vercel-Domain, spaeter die eigene (M0 Task 6).
SUPABASE_AUTH_SITE_URL=https://gymodo-web.vercel.app

# Exakte URLs, auf die Auth nach der Anmeldung umleiten darf.
SUPABASE_AUTH_ADDITIONAL_REDIRECT_URLS=https://gymodo-web.vercel.app/**

# Mindestabstand zwischen zwei Mails an dieselbe Adresse. Lokal 1s, damit
# Integrationstests OTPs in Folge anfordern koennen; hier der Cloud-Standard.
SUPABASE_AUTH_EMAIL_MAX_FREQUENCY=60s
